<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>qmul.ds</groupId>
  <artifactId>dylan</artifactId>
  <version>1.0-SNAPSHOT</version>
  <build>
    <sourceDirectory>src/java</sourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.2.4</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>qmul.ds.interactiveInduction.Experiments</mainClass>
                </transformer>
              </transformers>
              <includeSystemScope>true</includeSystemScope>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <dependencies>
    <dependency>
      <groupId>commons-collections</groupId>
      <artifactId>commons-collections</artifactId>
      <version>3.2.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/collections-generic-4.01.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>20231013</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/json-20231013.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.ptolemy</groupId>
      <artifactId>ptsupport</artifactId>
      <version>11.0.1</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/ptsupport.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>nz.ac.waikato.cms.weka</groupId>
      <artifactId>weka-stable</artifactId>
      <version>3.7.6</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/weka-3.7.6/weka.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-math</artifactId>
      <version>1.2</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/commons-math-1.2/commons-math-1.2.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.apache.opennlp</groupId>
      <artifactId>opennlp-tools</artifactId>
      <version>1.5.1-incubating</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/apache-opennlp-1.5.1-incubating/opennlp-tools-1.5.1-incubating.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.apache.opennlp</groupId>
      <artifactId>opennlp-maxent</artifactId>
      <version>3.0.1-incubating</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/apache-opennlp-1.5.1-incubating/opennlp-maxent-3.0.1-incubating.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>csli</groupId>
      <artifactId>ds</artifactId>
      <version>1.0</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/dist/jar/ds.jar</systemPath>
    </dependency>
  </dependencies>
</project>
